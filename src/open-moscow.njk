    <div class="advanced-filter" id="advanced-filter" aria-hidden="true">
        <div class="advanced-filter__overlay"></div>
        <div class="advanced-filter__modal" role="dialog" aria-modal="true">
            <button class="advanced-filter__close" type="button" aria-label="Закрыть"></button>
            <h2 class="advanced-filter__title">Расширенный поиск</h2>
            <form class="advanced-filter__form">
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Количество комнат:</div>
                    <div class="advanced-filter__options">
                        <label>
                            <input type="checkbox" name="rooms" value="studio">
                            <span>Студия</span>
                        </label>
                        <label>
                            <input type="checkbox" name="rooms" value="1">
                            <span>1 комната</span>
                        </label>
                        <label>
                            <input type="checkbox" name="rooms" value="2">
                            <span>2 комнаты</span>
                        </label>
                        <label>
                            <input type="checkbox" name="rooms" value="3">
                            <span>3 комнаты</span>
                        </label>
                        <label>
                            <input type="checkbox" name="rooms" value="4">
                            <span>4 и более комнат</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Оборудование и техника:</div>
                    <div class="advanced-filter__options">
                        <label>
                            <input type="checkbox" name="equipment" value="conditioner">
                            <span>Кондиционер</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="fridge">
                            <span>Холодильник</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="microwave">
                            <span>Микроволновка</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="washer">
                            <span>Стиральная машина</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="dishwasher">
                            <span>Посудомоечная машина</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="tv">
                            <span>Телевизор</span>
                        </label>
                        <label>
                            <input type="checkbox" name="equipment" value="internet">
                            <span>Интернет</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Этаж:</div>
                    <div class="advanced-filter__options">
                        <label>
                            <input type="checkbox" name="floor" value="not-first">
                            <span>Не первый</span>
                        </label>
                        <label>
                            <input type="checkbox" name="floor" value="not-last">
                            <span>Не последний</span>
                        </label>
                        <label>
                            <input type="checkbox" name="floor" value="last">
                            <span>Только последний</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Тип жилья:</div>
                    <div class="advanced-filter__options">
                        <label>
                            <input type="checkbox" name="type" value="flat">
                            <span>Квартиры</span>
                        </label>
                        <label>
                            <input type="checkbox" name="type" value="apartments">
                            <span>Апартаменты</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Санузел:</div>
                    <div class="advanced-filter__options">
                        <label>
                            <input type="checkbox" name="bathroom" value="separate">
                            <span>Раздельный</span>
                        </label>
                        <label>
                            <input type="checkbox" name="bathroom" value="combined">
                            <span>Совмещенный</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Балкон или Лоджия:</div>
