                        <label>
                            <input type="checkbox" name="balcony" value="loggia">
                            <span>Лоджия</span>
                        </label>
                        <label>
                            <input type="checkbox" name="balcony" value="none">
                            <span>Без</span>
                        </label>
                    </div>
                </div>
                <div class="advanced-filter__group">
                    <div class="advanced-filter__label">Правила:</div>
                    <div class="advanced-filter__options">
                        <label>
